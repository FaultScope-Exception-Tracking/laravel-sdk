{
    "name": "skywatch/laravel",
    "description": "Laravel integration package for Skywatch monitoring hub",
    "version": "1.3.0",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "skywatch", "exceptions", "monitoring", "error-tracking"],
    "homepage": "https://github.com/Skywatch-Exception-Tracking/laravel",
    "support": {
        "issues": "https://github.com/Skywatch-Exception-Tracking/laravel/issues",
        "source": "https://github.com/Skywatch-Exception-Tracking/laravel"
    },
    "authors": [
        {
            "name": "Skywatch",
            "homepage": "https://github.com/Skywatch-Exception-Tracking"
        }
    ],
    "autoload": {
        "psr-4": {
            "Skywatch\\Laravel\\": "src/"
        }
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.5"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Skywatch\\Laravel\\SkywatchServiceProvider"
            ]
        }
    }
}
