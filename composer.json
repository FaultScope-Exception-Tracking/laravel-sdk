{
    "name": "faultscope/laravel",
    "description": "Laravel integration package for FaultScope monitoring hub",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "faultscope", "exceptions", "monitoring", "error-tracking"],
    "homepage": "https://github.com/FaultScope-Exception-Tracking/laravel",
    "support": {
        "issues": "https://github.com/FaultScope-Exception-Tracking/laravel/issues",
        "source": "https://github.com/FaultScope-Exception-Tracking/laravel"
    },
    "authors": [
        {
            "name": "FaultScope",
            "homepage": "https://github.com/FaultScope-Exception-Tracking"
        }
    ],
    "autoload": {
        "psr-4": {
            "FaultScope\\Laravel\\": "src/"
        }
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.5"
    },
    "extra": {
        "laravel": {
            "providers": [
                "FaultScope\\Laravel\\FaultScopeServiceProvider"
            ]
        }
    }
}
